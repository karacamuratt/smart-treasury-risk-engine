    {
      "name": "4. Mock Scan Pipeline",
      "item": [
        {
          "name": "Trigger Listener Mock Block Scan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mock block scan queued', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.queued).to.eql(true);",
                  "    pm.expect(data.mode).to.eql('mock');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blockNumber\": {{mockBlockNumber}}\n}"
            },
            "url": {
              "raw": "{{listenerBaseUrl}}/scan/mock-block",
              "host": [
                "{{listenerBaseUrl}}"
              ],
              "path": [
                "scan",
                "mock-block"
              ]
            }
          }
        },
        {
          "name": "Get Demo Wallet Persisted Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Persisted transactions endpoint responds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.wallet.toLowerCase()).to.eql(pm.environment.get('demoWalletPrimary').toLowerCase());",
                  "    pm.expect(data.transactions).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
